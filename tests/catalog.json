  "sleep_rules": [
    {
      "rule_id": "R1",
      "version": "gen-case2-draft-2026-11-14",
      "description": "Вечерний свет. В течение 60 минут перед отбоем (до отбоя минус 5 минут) свет включён: яркость 10–30, цветовая температура не больше 2700 K. Если заселение позже чем за 60 минут до отбоя, правило действует с момента заселения и выполняется с первого шага."
    },
    {
      "rule_id": "R2",
      "version": "gen-case2-draft-2026-11-14",
      "description": "Темнота. От отбоя плюс 5 минут до начала рассвета яркость 0, шторы не больше 10."
    },
    {
      "rule_id": "R3",
      "version": "gen-case2-draft-2026-11-14",
      "description": "Температура. От отбоя плюс 5 минут до подъёма 19–20 °C; для гостя, который любит прохладу, 17–18 °C; для мерзлявого 21–22 °C."
    },
    {
      "rule_id": "R4",
      "version": "gen-case2-draft-2026-11-14",
      "description": "Звук. Через 5 минут после отбоя: если у гостя есть любимые звуки, играет трек из них, громкость 1–30, таймер 1–45 минут; если любимых звуков нет, громкость 0."
    },
    {
      "rule_id": "R5",
      "version": "gen-case2-draft-2026-11-14",
      "description": "Будильник. За 31 минуту до подъёма будильник стоит на целевое время подъёма с допуском 5 минут; если гость не любит резкие звуки, режим «свет»."
    },
    {
      "rule_id": "R6",
      "version": "gen-case2-draft-2026-11-14",
      "description": "Рассвет. Первый шаг, который после отбоя повышает яркость или открывает шторы, стоит за 15–30 минут до подъёма; до подъёма яркость растёт не меньше чем в три шага или шторы открываются не меньше чем на 50."
    },
    {
      "rule_id": "R7",
      "version": "gen-case2-draft-2026-11-14",
      "description": "Тишина. От отбоя плюс 5 минут до подъёма «Не беспокоить» включено."
    },
    {
      "rule_id": "R8",
      "version": "gen-case2-draft-2026-11-14",
      "description": "Перелёт. Привычный отбой из профиля задан по домашнему поясу. Если пояс отеля сдвинут относительно домашнего на 3 часа и больше, отбой сдвигается ровно на 1 час в сторону местного времени. R8 — поправка к отбою, отдельно не оценивается."
    }
  ]
